# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_USER=trackme
POSTGRES_PASSWORD=trackme_secret
POSTGRES_DB=trackme
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── MinIO (S3-compatible) ─────────────────────────────────────────────
MINIO_ROOT_USER=trackme_minio
MINIO_ROOT_PASSWORD=trackme_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Backend ───────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ── Nginx ─────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
