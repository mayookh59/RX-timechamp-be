# TrackMe Backend Environment Configuration
# Copy this file to .env and update values for your environment.

# PostgreSQL Database (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://trackme:trackme@localhost:5432/trackme
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=80

# Redis (cache + Celery broker)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# S3-Compatible Object Storage (screenshots)
S3_BUCKET=trackme-screenshots
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Application
VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
