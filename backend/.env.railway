# Railway Environment Variables
# Set these in Railway Dashboard > Variables

# DATABASE_URL is auto-set by Railway PostgreSQL addon
# DATABASE_URL=postgresql://...

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_KEY

# CORS - add your dashboard URL and remote origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-railway-app.up.railway.app

# Screenshots - stored locally (ephemeral on Railway)
# For persistent storage, use Railway Volume or Cloudflare R2
S3_ENDPOINT=
S3_BUCKET=trackme-screenshots
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Logging
LOG_LEVEL=INFO
